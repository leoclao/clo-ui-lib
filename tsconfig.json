{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "declaration": true,
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["packages/*/src"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["packages/**/*", "shared/**/*"]
}
